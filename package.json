{
  "name": "@ncuscc/recruitment-assessment-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "南昌大学超算俱乐部（NCUSCC）招新考核题目构建与运行框架",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/NCUSCC/2026-Autumn-Recruitment.git"
  },
  "homepage": "https://github.com/NCUSCC/2026-Autumn-Recruitment",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/editor",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.6",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.0"
  }
}
